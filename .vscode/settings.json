{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    "source.organizeImports": "explicit",
    "source.fixAll.prettier": "never"
  },

  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": false,
  "editor.detectIndentation": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "css.lint.unknownAtRules": "ignore",

  "files.associations": {
    "*.css": "css"
  },
  "editor.quickSuggestions": {
    "strings": "on"
  },

  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.exclude": {
    "**/.svn": false,
    "**/.hg": false,
    "**/Thumbs.db": false,
    "**/.ruff_cache": true,
    "backend/.hypothesis": false,
    "**/.jj": false,
    ".ruff_cache": true,
    "**/.idea": true,
    "**/.mypy_cache": true
  },

  "vitest.rootConfig": "frontend/vitest.config.ts",

  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["backend"],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",
  "pytest.command": "/Users/f_aleksandrov/projects/week-eat-planner/.venv_python3.14/bin/pytest",
  "ruff.exclude": ["**/test*.py"],
  "explorerExcludeManager.backup": {},
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv_python3.14/bin/python",
  "python-envs.workspaceSearchPaths": ["./.venv*"],
  "python-envs.pythonProjects": [
    {
      "path": "qa",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "backend",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ]
}
