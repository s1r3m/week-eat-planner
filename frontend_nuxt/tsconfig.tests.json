{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["bun-types", "node"],
		"paths": {
			"@/*": ["./app/*"],
			"~/*": ["./app/*"]
		}
	},
	"include": ["tests/**/*", ".nuxt/nuxt.d.ts"]
}
