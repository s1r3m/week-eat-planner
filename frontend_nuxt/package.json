{
  "name": "fe_nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint app tests && eslint app tests vitest.config.ts --concurrency auto --cache --max-warnings=0 && stylelint \"app/**/*.{vue,css}\"",
    "lint:fix": "oxlint app tests --fix && eslint --fix app tests vitest.config.ts && stylelint --fix \"app/**/*.{vue,css}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:typecheck": "vue-tsc --noEmit --project tsconfig.tests.json"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/icon": "^2.3.1",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/nuxt": "^1.0.1",
    "@vee-validate/zod": "^4.15.1",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@iconify-json/lucide": "^1.2.120",
    "@nuxtjs/color-mode": "^4.0.1",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-oxlint": "^1.75.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jsdom": "^27.4.0",
    "nuxt-open-fetch": "^0.13.9",
    "oxlint": "^1.75.0",
    "postcss-custom-media": "^12.0.1",
    "postcss-functions": "^4.0.2",
    "postcss-mixins": "^12.1.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.0",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
